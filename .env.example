# Copie para .env e ajuste se necessário. Banco é um arquivo SQLite local
# (sem servidor, sem Docker) -- criado e migrado automaticamente dentro de
# CargoFlow.Api/ no primeiro dotnet run.

ConnectionStrings__DefaultConnection=Data Source=cargoflow.db

# Assina os JWT emitidos em POST /api/auth/login. Gere um novo com:
#   openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-openssl-rand-hex-32
