<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só as interfaces do MediatR (INotification); o pacote MediatR completo
         (IMediator, handlers, pipeline) fica só na Application, mantendo a
         regra de "Domain sem dependência nenhuma" praticamente intacta. -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

</Project>
